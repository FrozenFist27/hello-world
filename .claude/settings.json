{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEARNO_DB=\"$CLAUDE_PROJECT_DIR/chess-study/learno.db\" node --no-warnings \"$CLAUDE_PROJECT_DIR/chess-study/bin/due-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
