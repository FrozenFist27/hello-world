# Optional. learno runs with no .env at all: answers are graded by your own
# Claude Code login and progress lives in learno.db at the repo root.

PORT=9990
# LEARNO_DB=learno.db              # progress store, relative to the repo root

# Grading. Without a Gemini key, `claude -p` grades each answer (~10s, uses your plan).
# GEMINI_API_KEY=                  # set it to grade with Gemini instead (~2-3s)
# GEMINI_MODEL=gemini-2.5-flash
# LEARNO_GRADER=claude             # force one grader: claude | gemini
# LEARNO_CLAUDE_MODEL=haiku

# Engine development only:
# LEARNO_WORKSPACE — workspace to serve; defaults to the repo root. Used by `make sandbox`.
# LEARNO_MODE=sandbox — seeded in-memory store and stubbed grader; nothing needed.
