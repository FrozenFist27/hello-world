      ] },

    { "component": "phase", "props": { "id": "3", "title": "@p3.title" },
      "children": [
        { "component": "prose", "props": { "text": "@p3.body" } },
        { "component": "board", "props": { "fen": "@p3.fen", "caption": "@p3.caption" } },
